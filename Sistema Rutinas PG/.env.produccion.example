# Entorno de producción (apartado 3.8 de la tesis).
#
# Copie este archivo como `.env.produccion` y reemplace TODOS los valores. El
# sistema se niega a arrancar en producción si detecta que alguna credencial
# conserva su valor de ejemplo, porque un despliegue con la contraseña escrita
# en el repositorio deja la cuenta de administrador al alcance de cualquiera que
# lea el código.
#
#     docker compose -f docker-compose.produccion.yml --env-file .env.produccion up -d

# --- Entorno --------------------------------------------------------------
# Debe decir «produccion» para que se active la verificación de credenciales.
ENTORNO=produccion

# --- Base de datos --------------------------------------------------------
# Genere contraseñas largas y aleatorias, distintas entre sí:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
MYSQL_ROOT_PASSWORD=CAMBIE-esta-contrasena-de-root
MYSQL_DATABASE=sistema_rutinas
MYSQL_USER=rutinas
MYSQL_PASSWORD=CAMBIE-esta-contrasena-de-usuario

# --- Firma de los tokens de sesión ---------------------------------------
# Genere una clave propia. Si se filtra, cualquiera puede emitir tokens válidos:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=CAMBIE-esta-clave-antes-de-desplegar

# Minutos de inactividad tras los cuales la sesión expira (criterio de HU-02).
MINUTOS_EXPIRACION_SESION=30

# --- Orígenes autorizados -------------------------------------------------
# El dominio propio del sistema, con el protocolo. Separe varios con coma.
ORIGENES_PERMITIDOS=https://sudominio.gt

# --- Cuenta de administrador inicial -------------------------------------
# Use un correo real del gimnasio y una contraseña que no esté en ningún
# archivo de ejemplo.
ADMIN_CORREO=administrador@sudominio.gt
ADMIN_CONTRASENA=CAMBIE-esta-contrasena-de-administrador
ADMIN_NOMBRE=Administrador del sistema

# --- Publicación ----------------------------------------------------------
# Puerto en que la composición publica la interfaz. El proxy inverso del
# servidor escucha en 443 con el certificado y reenvía a este puerto.
PUERTO_PUBLICO=8080

# --- Respaldos ------------------------------------------------------------
# Días que se conservan los volcados de la base de datos.
DIAS_DE_RETENCION=30
