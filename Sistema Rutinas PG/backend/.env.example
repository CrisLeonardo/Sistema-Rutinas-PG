# Copie este archivo como .env y ajuste los valores segun su entorno.

# Conexion a la base de datos PostgreSQL levantada con docker compose
URL_BASE_DATOS=postgresql+psycopg://rutinas:rutinas_pass@localhost:5433/sistema_rutinas

# Clave de firma de los tokens de sesion.
# Genere una propia con: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=cambie-esta-clave-antes-de-desplegar-en-produccion

# Minutos de inactividad tras los cuales la sesion expira (criterio HU-02)
MINUTOS_EXPIRACION_SESION=30

# Origenes autorizados para la interfaz de cliente, separados por coma
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Cuenta de administrador creada automaticamente al iniciar el sistema
ADMIN_CORREO=admin@sistemarutinas.gt
ADMIN_CONTRASENA=Admin12345
ADMIN_NOMBRE=Administrador del sistema

# Recuperación de acceso. Configure valores reales por variables de entorno.
# Sin servidor y remitente, el formulario indica que el envío no está disponible.
URL_PUBLICA_FRONTEND=http://127.0.0.1:5173
CORREO_CONTACTO=senda1986.gt@gmail.com
CORREO_TRANSPORTE=gmail_api
CORREO_REMITENTE=senda1986.gt@gmail.com
GMAIL_CLIENTE_ID=
GMAIL_CLIENTE_SECRETO=
GMAIL_REFRESH_TOKEN=
# SMTP es una alternativa para desarrollo u otro alojamiento.
# Render gratuito bloquea los puertos 25, 465 y 587.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=senda1986.gt@gmail.com
SMTP_CONTRASENA=
SMTP_REMITENTE=senda1986.gt@gmail.com

# Comunidad pospuesta; conservar false en la entrega individual.
COMUNIDAD_HABILITADA=false

# Admisión asíncrona por proceso, por debajo del máximo de 10 conexiones SQL.
SOLICITUDES_ACTIVAS_BD=5
