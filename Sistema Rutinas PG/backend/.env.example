# Copie este archivo como .env y ajuste los valores segun su entorno.

# Conexion a la base de datos MySQL levantada con docker compose
URL_BASE_DATOS=mysql+pymysql://rutinas:rutinas_pass@localhost:3307/sistema_rutinas

# Clave de firma de los tokens de sesion.
# Genere una propia con: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=cambie-esta-clave-antes-de-desplegar-en-produccion

# Minutos de inactividad tras los cuales la sesion expira (criterio HU-02)
MINUTOS_EXPIRACION_SESION=30

# Origenes autorizados para la interfaz de cliente, separados por coma
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Cuenta de administrador creada automaticamente al iniciar el sistema
ADMIN_CORREO=admin@sistemarutinas.gt
ADMIN_CONTRASENA=Admin12345
ADMIN_NOMBRE=Administrador del sistema
