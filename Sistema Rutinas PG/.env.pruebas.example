# Entorno de pruebas (apartado 3.8 de la tesis).
#
# Copie este archivo como `.env.pruebas` y reemplace TODOS los valores. El
# sistema se niega a arrancar si detecta que alguna credencial conserva su
# valor de ejemplo, porque un despliegue con la contraseña escrita en el
# repositorio deja la cuenta de administrador al alcance de cualquiera que
# lea el código.
#
#     docker compose -f docker-compose.pruebas.yml --env-file .env.pruebas up -d
#
# Las credenciales de producción NO van en este archivo: viven en el panel de
# Render y en el de Supabase, y nunca en el repositorio. Consulte DESPLIEGUE.md.

# --- Base de datos --------------------------------------------------------
# Genere contraseñas largas y aleatorias, distintas entre sí:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=sistema_rutinas
POSTGRES_USER=rutinas
POSTGRES_PASSWORD=CAMBIE-esta-contrasena-de-la-base-de-datos

# --- Firma de los tokens de sesión ---------------------------------------
# Genere una clave propia. Si se filtra, cualquiera puede emitir tokens válidos:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SECRETA=CAMBIE-esta-clave-antes-de-desplegar

# Minutos de inactividad tras los cuales la sesión expira (criterio de HU-02).
MINUTOS_EXPIRACION_SESION=30

# --- Orígenes autorizados -------------------------------------------------
# La dirección con que se alcanza esta composición. Separe varias con coma.
ORIGENES_PERMITIDOS=http://localhost:8080

# --- Cuenta de administrador inicial -------------------------------------
# Los valores con espacios van entre comillas: los scripts de respaldo leen este
# archivo con el intérprete de órdenes, que de otro modo tomaría cada palabra
# como una orden aparte.
# Una contraseña que no esté en ningún archivo de ejemplo. El correo debe ser una
# dirección válida: el sistema la valida al crear la cuenta, y dominios reservados
# como «.local» la hacen fallar al arrancar.
ADMIN_CORREO=administrador@pruebas.gt
ADMIN_CONTRASENA=CAMBIE-esta-contrasena-de-administrador
ADMIN_NOMBRE="Administrador del sistema"

# --- Publicación ----------------------------------------------------------
# Puerto en que la composición publica la interfaz.
PUERTO_PUBLICO=8080

# --- Respaldos ------------------------------------------------------------
# Días que se conservan los volcados de la base de datos.
DIAS_DE_RETENCION=30
