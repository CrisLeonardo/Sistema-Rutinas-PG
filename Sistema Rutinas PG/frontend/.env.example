# Direccion base de la interfaz de programacion de aplicaciones.
# Se usa 127.0.0.1 y no "localhost" de forma deliberada: en Windows "localhost"
# se resuelve primero a IPv6 y el puerto puede estar tomado por otro servicio,
# como el reenvio de puertos de Docker o WSL.
VITE_URL_API=http://127.0.0.1:8010/api/v1
